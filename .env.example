# Kitten Companion — Environment Variables Template
# Copy this file to .env.local and fill in actual values.
# Never commit .env.local to version control.
# See TDD Section 8.2 for environment variable documentation.

# ------------------------------------------------------------------
# Database (PostgreSQL 15)
# TDD Section 1.1, 5.2
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newcat_dev
DB_USER=devuser
DB_PASSWORD=

# ------------------------------------------------------------------
# Redis (Cache & JWT blocklist)
# TDD Section 5.1
# ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------
# Authentication
# TDD Section 2.1, 11.2
# ------------------------------------------------------------------
# HS256 secret — must be at least 32 random bytes in production
JWT_SECRET=
# JWT token validity in seconds (default: 604800 = 7 days)
JWT_EXPIRY=604800
# OTP one-time code validity in minutes (default: 1440 = 24 hours)
OTP_EXPIRY_MINUTES=1440

# ------------------------------------------------------------------
# Email (SendGrid)
# TDD Section 3.1
# ------------------------------------------------------------------
SENDGRID_API_KEY=

# ------------------------------------------------------------------
# LLM Integration
# TDD Section 4.1
# ------------------------------------------------------------------
# Direct Anthropic API key (non-Bedrock deployments)
ANTHROPIC_API_KEY=
# AWS Bedrock region (Bedrock deployments — alternative to ANTHROPIC_API_KEY)
AWS_BEDROCK_REGION=us-east-1

# ------------------------------------------------------------------
# AWS
# TDD Section 9.1
# ------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# LocalStack endpoint for local development (leave empty for real AWS)
LOCALSTACK_ENDPOINT=http://localhost:4566

# ------------------------------------------------------------------
# Logging
# TDD Section 10.1
# ------------------------------------------------------------------
# Valid values: debug | info | warn | error
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Application environment
# ------------------------------------------------------------------
# Valid values: local | dev | staging | prod
ENVIRONMENT=local
