#!/bin/bash
# .githooks/pre-push
# Runs before push to validate changes
# Checks: test suite, compilation, security audit

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

FAILED=0
WARNINGS=0

echo -e "${GREEN}Running pre-push checks...${NC}\n"

# Detect which services changed since origin/main
detect_changed_services() {
    local changed_services=()

    if ! git rev-parse origin/main &>/dev/null 2>&1; then
        echo -e "${YELLOW}origin/main not found, will test all services${NC}"
        echo "auth user notification pet checkin triage pattern-detection vet-summary"
        return
    fi

    local changed_files=$(git diff origin/main...HEAD --name-only)

    for service in auth user notification pet checkin triage pattern-detection vet-summary; do
        if echo "$changed_files" | grep -q "^services/$service/"; then
            changed_services+=("$service")
        fi
    done

    if [ ${#changed_services[@]} -eq 0 ]; then
        echo "none"
    else
        echo "${changed_services[@]}"
    fi
}

# ============================================================
# 1. COMPILATION CHECK
# ============================================================

echo -e "${BLUE}[Build] Checking compilation...${NC}\n"

# Test Node.js services compile
for service in auth user notification; do
    if [ -f "services/$service/package.json" ]; then
        echo -e "${YELLOW}Building $service (Node.js)...${NC}"
        cd "services/$service"
        if npm run build 2>/dev/null | head -20; then
            echo -e "${GREEN}✓ $service compiled${NC}\n"
        else
            echo -e "${RED}✗ $service compilation failed${NC}"
            ((FAILED++))
        fi
        cd - > /dev/null
    fi
done

# Test Java services compile
for service in pet checkin triage pattern-detection vet-summary; do
    if [ -f "services/$service/pom.xml" ]; then
        echo -e "${YELLOW}Building $service (Java)...${NC}"
        cd "services/$service"
        if mvn clean compile -q 2>/dev/null; then
            echo -e "${GREEN}✓ $service compiled${NC}\n"
        else
            echo -e "${RED}✗ $service compilation failed${NC}"
            ((FAILED++))
        fi
        cd - > /dev/null
    fi
done

# ============================================================
# 2. TEST SUITE
# ============================================================

echo -e "${BLUE}[Tests] Running test suite...${NC}\n"

changed=$(detect_changed_services)

if [ "$changed" = "none" ]; then
    echo -e "${YELLOW}No service changes detected, skipping tests${NC}"
else
    echo -e "${YELLOW}Running tests for changed services: $changed${NC}\n"

    # Run tests for changed services
    for service in $changed; do
        if [ -f "services/$service/package.json" ]; then
            echo -e "${YELLOW}Testing $service (Node.js)...${NC}"
            cd "services/$service"
            if npm test 2>&1 | tail -20; then
                echo -e "${GREEN}✓ $service tests passed${NC}\n"
            else
                echo -e "${RED}✗ $service tests failed${NC}"
                ((FAILED++))
            fi
            cd - > /dev/null
        elif [ -f "services/$service/pom.xml" ]; then
            echo -e "${YELLOW}Testing $service (Java)...${NC}"
            cd "services/$service"
            if mvn test -q 2>&1 | tail -20; then
                echo -e "${GREEN}✓ $service tests passed${NC}\n"
            else
                echo -e "${RED}✗ $service tests failed${NC}"
                ((FAILED++))
            fi
            cd - > /dev/null
        fi
    done
fi

# ============================================================
# 3. QUICK SECURITY AUDIT
# ============================================================

echo -e "${BLUE}[Security] Running quick security audit...${NC}\n"

# Check for hardcoded secrets in code
echo -e "${YELLOW}Scanning for hardcoded secrets...${NC}"
secret_patterns=(
    "API_KEY\s*="
    "SECRET\s*="
    "PASSWORD\s*="
    "private_key"
    "aws_access_key_id"
)

for pattern in "${secret_patterns[@]}"; do
    if git diff origin/main...HEAD | grep -iE "$pattern" 2>/dev/null; then
        echo -e "${YELLOW}⚠ Potential secret detected: $pattern${NC}"
        ((WARNINGS++))
    fi
done

# Check for SQL injection patterns
echo -e "${YELLOW}Scanning for SQL injection patterns...${NC}"
injection_patterns=(
    'SELECT.*\$'
    'concat\s*\('
    '"[^"]*"\s*\+\s*var'
)

for pattern in "${injection_patterns[@]}"; do
    if git diff origin/main...HEAD -- '*.ts' '*.java' | grep -E "$pattern" 2>/dev/null | head -1; then
        echo -e "${YELLOW}⚠ Possible SQL injection pattern: $pattern${NC}"
        ((WARNINGS++))
    fi
done

# Check JWT validation in handlers
echo -e "${YELLOW}Checking JWT validation...${NC}"
if git diff origin/main...HEAD -- 'services/*/src/*Lambda.java' | grep -q "jwtValidator"; then
    echo -e "${GREEN}✓ JWT validation detected in handlers${NC}"
else
    if git diff origin/main...HEAD | grep -q "Lambda\|handler"; then
        echo -e "${YELLOW}⚠ New handler detected but no JWT validation found${NC}"
        ((WARNINGS++))
    fi
fi

# ============================================================
# SUMMARY
# ============================================================

echo ""
echo -e "${BLUE}═══════════════════════════════════════${NC}"

if [ $FAILED -gt 0 ]; then
    echo -e "${RED}Pre-push FAILED with $FAILED error(s)${NC}"
    echo "Fix the issues above and try again."
    echo "Use 'git push --no-verify' to skip pre-push checks."
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}Pre-push completed with $WARNINGS warning(s)${NC}"
    echo -e "${GREEN}Push allowed, but review warnings above${NC}"
    exit 0
else
    echo -e "${GREEN}✓ All pre-push checks passed${NC}"
    exit 0
fi
